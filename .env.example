# ============ Sepolia 网络 RPC 节点 ============
# 公共节点默认使用 publicnode；国内可能较慢/不稳定，推荐换成自己的 Alchemy / Infura：
# https://eth-sepolia.g.alchemy.com/v2/你的API_KEY
RPC_URL=https://ethereum-sepolia.publicnode.com

# ============ 要转账的 ERC20 代币合约地址（Sepolia 测试网） ============
# 默认填的是 Circle 官方 Sepolia USDC（6 位小数），可在 faucet.circle.com 免费领取。
# 也可以换成你自己部署 / 其他测试代币的合约地址；build 时可用 --token 临时覆盖。
TOKEN_ADDRESS=0x1c7d4b196cb0c7b01d743fbc6116a902379c7238

# 浏览器资产/交易查询地址（只读，无需修改）
EXPLORER_URL=https://sepolia.etherscan.io
